# Azure AI Project Configuration
# Replace with your actual Azure AI Project endpoint
AZURE_AI_PROJECT_ENDPOINT=https://your-endpoint.services.ai.azure.com/api/projects/your-project

# Replace with your desired model (e.g., gpt-4, gpt-4-turbo, gpt-3.5-turbo)
AZURE_AI_MODEL=gpt-4.1-nano

# MCP Server Configuration
# Replace with your MCP server URL
MCP_SERVER_URL=https://learn.microsoft.com/api/mcp
